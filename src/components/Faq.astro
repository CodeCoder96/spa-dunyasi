---
// Visible FAQ with <details> (SAB-02). The same items feed FAQPage JSON-LD on this page only (SEO-08).
import { marked } from '../lib/inline-md.ts';

interface Props {
  items: { q: string; a: string }[];
  title: string;
  id?: string;
  lang: 'tr' | 'en';
}
const { items, title, id = 'faq', lang } = Astro.props;
---

{
  items.length > 0 && (
    <section class="faq" aria-labelledby={`${id}-title`}>
      <h2 id={`${id}-title`}>{title}</h2>
      <div class="faq__list">
        {items.map((it) => (
          <details class="faq__item">
            <summary>{it.q}</summary>
            <div class="faq__answer" set:html={marked(it.a, lang)} />
          </details>
        ))}
      </div>
    </section>
  )
}

<style>
  @layer components {
    .faq {
      display: grid;
      gap: var(--s-4);
      max-width: 820px;
    }

    .faq h2 {
      font-size: var(--fs-h3);
    }

    .faq__list {
      border-top: var(--border);
    }

    .faq__item {
      border-bottom: var(--border);
    }

    .faq__item summary {
      position: relative;
      display: block;
      padding: var(--s-4) var(--s-10) var(--s-4) 0;
      min-height: 44px;
      font-weight: 600;
      cursor: pointer;
      list-style: none;
    }

    .faq__item summary::-webkit-details-marker {
      display: none;
    }

    .faq__item summary::after {
      content: '';
      position: absolute;
      right: var(--s-2);
      top: 1.45em;
      width: 0.6em;
      height: 0.6em;
      border-right: 2px solid currentcolor;
      border-bottom: 2px solid currentcolor;
      transform: rotate(45deg);
      transition: transform var(--dur) var(--ease);
    }

    .faq__item[open] summary::after {
      transform: rotate(-135deg);
    }

    .faq__answer {
      padding-bottom: var(--s-4);
      color: var(--c-ink-2);
      max-width: var(--measure);
    }

    @media print {
      .faq__answer {
        display: block;
      }
    }
  }
</style>
