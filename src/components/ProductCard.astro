---
// Product card (SAB-04): 4:3 stage (studio → contain on white, scene → cover), bronze category tag,
// name wraps up to 3 lines, ≤2 size chips, add-to-quote icon button above a stretched link.
import Img from './Img.astro';
import Icon from './Icon.astro';
import Placeholder from './Placeholder.astro';
import type { Product } from '../lib/catalog-schema.ts';
import { CATEGORY_META } from '../lib/categories.ts';
import { dimensionChips } from '../lib/catalog.ts';
import { asset } from '../lib/images.ts';
import { href } from '../lib/routes.ts';
import { t, type Lang } from '../i18n/ui.ts';

interface Props {
  product: Product;
  lang: Lang;
  headingLevel?: 'h2' | 'h3';
  ctaLocation?: string;
}
const { product: p, lang, headingLevel = 'h3', ctaLocation = 'product_card' } = Astro.props;
const H = headingLevel;
const img = p.images[0];
const chips = dimensionChips(p, lang, 2);
---

<article class="pcard" data-category={p.category} data-code={p.code}>
  <div class:list={['pcard__stage', img?.fit === 'contain' && 'pcard__stage--studio']}>
    {
      img ? (
        <Img src={asset(img.file)} alt={img.alt[lang]} sizes="(width >= 1280px) 300px, (width >= 768px) 33vw, (width >= 480px) 50vw, 100vw" maxWidth={640} fit={img.fit} />
      ) : (
        <Placeholder lang={lang} />
      )
    }
  </div>
  <div class="pcard__body">
    <span class="tag">{CATEGORY_META[p.category].short[lang]}</span>
    <H class="pcard__title">
      <a class="pcard__link" href={href(lang, `urun:${p.code}`)} translate="no">{p.name[lang]}</a>
    </H>
    <span class="code" translate="no">{p.code}</span>
    {
      chips.length > 0 && (
        <ul role="list" class="pcard__chips">
          {chips.map((c) => (
            <li class="chip">{c}</li>
          ))}
        </ul>
      )
    }
  </div>
  <button type="button" class="pcard__quote" hidden data-quote-add={p.code} data-cta={ctaLocation} aria-label={`${t(lang, 'quote.add')}: ${p.name[lang]}`}>
    <Icon name="plus" size={20} />
  </button>
</article>

<style>
  @layer components {
    .pcard {
      position: relative;
      container-type: inline-size;
      display: flex;
      flex-direction: column;
      background: var(--c-surface);
      border: var(--border);
      border-radius: var(--radius-card);
      overflow: hidden;
      transition: border-color var(--dur) var(--ease), box-shadow var(--dur) var(--ease);
    }

    .pcard[hidden] {
      display: none;
    }

    .pcard__stage {
      aspect-ratio: 4 / 3;
      background: var(--c-sand);
      overflow: hidden;
    }

    .pcard__stage :global(.img) {
      width: 100%;
      height: 100%;
    }

    .pcard__stage--studio {
      background: var(--c-surface);
      padding: var(--s-3);
    }

    .pcard__body {
      display: grid;
      gap: var(--s-2);
      padding: var(--s-4) var(--s-4) var(--s-5);
      align-content: start;
    }

    .pcard__title {
      font-size: 1.25rem;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .pcard__link {
      color: var(--c-ink);
      text-decoration: none;
    }

    /* Stretched link: the whole card is clickable (SAB-04). */
    .pcard__link::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: 1;
      border-radius: var(--radius-card);
    }

    .pcard__link:focus-visible {
      outline: none;
    }

    .pcard__link:focus-visible::after {
      outline: 2px solid var(--c-focus);
      outline-offset: 2px;
    }

    .pcard__chips {
      display: flex;
      flex-wrap: wrap;
      gap: var(--s-2);
      margin-top: var(--s-1);
    }

    .pcard__quote {
      position: absolute;
      z-index: 2;
      top: var(--s-3);
      right: var(--s-3);
      display: inline-grid;
      place-items: center;
      width: 44px;
      height: 44px;
      border-radius: var(--radius-pill);
      background: var(--c-surface);
      border: var(--border);
      color: var(--c-primary);
      box-shadow: var(--shadow-card);
    }

    .pcard__quote[hidden] {
      display: none;
    }

    @media (hover: hover) {
      .pcard:hover {
        border-color: var(--c-ink-2);
      }

      .pcard:hover .pcard__link {
        color: var(--c-primary);
      }

      .pcard__quote:hover {
        background: var(--c-primary);
        color: var(--c-on-primary);
      }
    }

    @container (width >= 340px) {
      .pcard__title {
        font-size: 1.375rem;
      }
    }
  }
</style>
