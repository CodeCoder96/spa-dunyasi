---
// Responsive <picture> with AVIF + WebP (PER-03). Width/height always set (PER-07).
import type { ImageMetadata } from 'astro';
import { buildImage } from '../lib/images.ts';

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  maxWidth?: number;
  priority?: boolean;
  class?: string;
  fit?: 'contain' | 'cover';
  /** Lower network priority for images that are lazy but likely to load early (off-screen gallery slides). */
  lowPriority?: boolean;
}

const { src, alt, sizes, maxWidth = 1600, priority = false, class: cls, fit = 'cover', lowPriority = false } = Astro.props;
const img = await buildImage(src, maxWidth);
---

<picture class:list={['img', `img--${fit}`, cls]}>
  <source type="image/avif" srcset={img.avif} sizes={sizes} />
  <img
    src={img.src}
    srcset={img.webp}
    sizes={sizes}
    width={img.width}
    height={img.height}
    alt={alt}
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : lowPriority ? 'low' : 'auto'}
  />
</picture>

<style>
  @layer components {
    .img {
      display: block;
    }

    .img img {
      width: 100%;
      height: 100%;
    }

    .img--cover img {
      object-fit: cover;
      object-position: center;
    }

    .img--contain img {
      object-fit: contain;
    }
  }
</style>
