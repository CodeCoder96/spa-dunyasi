---
// Branded placeholder for products without photos (KAY-17). Contains no product name.
import { t, type Lang } from '../i18n/ui.ts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
---

<div class="placeholder" role="img" aria-label={t(lang, 'product.placeholder')}>
  <svg viewBox="0 0 160 120" width="160" height="120" aria-hidden="true">
    <ellipse cx="80" cy="92" rx="46" ry="14" />
    <ellipse cx="81" cy="68" rx="35" ry="11.5" />
    <ellipse cx="79" cy="47" rx="24" ry="9.5" />
  </svg>
</div>

<style>
  @layer components {
    .placeholder {
      display: grid;
      place-items: center;
      width: 100%;
      height: 100%;
      min-height: 160px;
      background: var(--c-sand);
    }

    .placeholder svg {
      width: 40%;
      height: auto;
      fill: var(--c-line);
    }
  }
</style>
